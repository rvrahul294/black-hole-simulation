// ============================================================================
// GPU Compute Shader: 3D Black Hole Ray Tracing & Gravitational Lensing
// ============================================================================
//
// What this shader does:
// This compute shader simulates gravitational lensing around a supermassive
// black hole (Sagittarius A*). For each pixel on screen, it calculates the
// path of a light ray (a null geodesic) traveling through curved spacetime.
//
// Why use the GPU?
// Tracing a curved light ray requires tens of thousands of numerical integration
// steps. Doing this for every pixel on the CPU is slow; on the GPU, thousands of
// threads run simultaneously across compute workgroups, allowing real-time
// 3D visualization.
//
// Execution Model:
// - Each invocation (thread) computes the color for exactly one pixel.
// - Threads are organized in 16x16 workgroups (256 threads per group).
// - The final pixel colors are written directly into an OpenGL 2D texture.
// ============================================================================

#version 430
layout(local_size_x = 16, local_size_y = 16) in;

// ----------------------------------------------------------------------------
// Uniform Buffers & Output Image (Data received from CPU)
// ----------------------------------------------------------------------------

// Binding 0: Output 2D texture where ray-traced pixel colors are stored
layout(binding = 0, rgba8) writeonly uniform image2D outImage;

// Binding 1: Camera state (position, basis vectors, aspect ratio, and field of view)
// std140 layout requires explicit padding floats for 16-byte alignment of vec3
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

// Binding 2: Accretion disk geometric dimensions
layout(std140, binding = 2) uniform Disk {
    float disk_r1;   // Inner radius of the accretion disk in meters
    float disk_r2;   // Outer radius of the accretion disk in meters
    float disk_num;  // Disk density / ray count parameter
    float thickness; // Accretion disk vertical thickness in meters
};

// Binding 3: Celestial objects in the scene (e.g. orbiting stars and black hole)
layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16]; // xyz = position in meters, w = radius in meters
    vec4 objColor[16];     // rgb = surface color
    float  mass[16];       // Mass in kilograms
};

// ----------------------------------------------------------------------------
// Physical & Numerical Constants
// ----------------------------------------------------------------------------
// Schwarzschild radius of Sagittarius A* (event horizon boundary in meters)
// Inside this radius, light cannot escape.
const float SagA_rs = 1.269e10;

// Integration step size along the ray's affine parameter (lambda)
const float D_LAMBDA = 1e7;

// Distance threshold for rays that escape into deep space (meters)
const double ESCAPE_R = 1e30;

// Globals to store intersection information when a ray hits a celestial object
vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);
float hitRadius = 0.0;

// ----------------------------------------------------------------------------
// Light Ray State Representation
// ----------------------------------------------------------------------------
// A light ray is tracked in both Cartesian (x, y, z) and spherical (r, theta, phi)
// coordinates, along with its coordinate velocities and conserved physical quantities.
struct Ray {
    float x, y, z, r, theta, phi;
    float dr, dtheta, dphi;
    float E, L; // Conserved Energy and Angular Momentum
};

// Initializes a ray starting at the camera position in a given direction
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi = atan(pos.y, pos.x);

    // Convert Cartesian direction vector into spherical velocity components
    float dx = dir.x, dy = dir.y, dz = dir.z;
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    // Calculate conserved constants of motion from the Schwarzschild metric
    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    float f = 1.0 - SagA_rs / ray.r; // Metric lapse factor: (1 - r_s / r)
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

// Checks if the ray has entered the event horizon (r <= r_s)
bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}

// Tests intersection with spherical celestial objects (e.g. stars)
// Returns true on hit and captures center, radius, and color for shading
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            hitRadius = radius;
            return true;
        }
    }
    return false;
}

// ----------------------------------------------------------------------------
// Geodesic Equations (Right-Hand Side Derivatives)
// ----------------------------------------------------------------------------
// Computes the rate of change of spherical coordinates (d1) and velocities (d2)
// derived from Einstein's General Relativity for null geodesics in Schwarzschild spacetime.
void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float f = 1.0 - SagA_rs / r;
    float dt_dL = ray.E / f;

    // First derivatives: [dr/dlambda, dtheta/dlambda, dphi/dlambda]
    d1 = vec3(dr, dtheta, dphi);

    // Second derivatives: Curvature accelerations acting on the light ray
    d2.x = - (SagA_rs / (2.0 * r*r)) * f * dt_dL * dt_dL
         + (SagA_rs / (2.0 * r*r * f)) * dr * dr
         + r * (dtheta*dtheta + sin(theta)*sin(theta)*dphi*dphi);
    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/(sin(theta)) * dtheta * dphi;
}

// ----------------------------------------------------------------------------
// Numerical Integration Step
// ----------------------------------------------------------------------------
// Steps the ray forward along its curved trajectory across step size dL
// and updates both spherical and Cartesian coordinates.
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b;
    geodesicRHS(ray, k1a, k1b);

    ray.r      += dL * k1a.x;
    ray.theta  += dL * k1a.y;
    ray.phi    += dL * k1a.z;
    ray.dr     += dL * k1b.x;
    ray.dtheta += dL * k1b.y;
    ray.dphi   += dL * k1b.z;

    // Convert updated spherical coordinates back to Cartesian (x, y, z)
    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}

// Checks if the curved ray crosses the accretion disk on the equatorial plane (y = 0)
// between the inner radius (disk_r1) and outer radius (disk_r2)
bool crossesEquatorialPlane(vec3 oldPos, vec3 newPos) {
    bool crossed = (oldPos.y * newPos.y < 0.0);
    float r = length(vec2(newPos.x, newPos.z));
    return crossed && (r >= disk_r1 && r <= disk_r2);
}

// ----------------------------------------------------------------------------
// Main Compute Kernel (Per-Pixel Ray Tracing)
// ----------------------------------------------------------------------------
void main() {
    // Dynamic resolution scaling: match active compute texture dimensions
    int WIDTH  = cam.moving ? 200 : 200;
    int HEIGHT = cam.moving ? 150 : 150;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    // 1) Construct primary ray from camera through current pixel in normalized screen space
    float u = (2.0 * (pix.x + 0.5) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    float lambda = 0.0;

    bool hitBlackHole = false;
    bool hitDisk      = false;
    bool hitObject    = false;

    int steps = cam.moving ? 60000 : 60000;

    // 2) March the light ray forward step-by-step through curved spacetime
    for (int i = 0; i < steps; ++i) {
        // Stop if ray falls into the black hole event horizon
        if (intercept(ray, SagA_rs)) { hitBlackHole = true; break; }

        rk4Step(ray, D_LAMBDA);
        lambda += D_LAMBDA;

        vec3 newPos = vec3(ray.x, ray.y, ray.z);

        // Check for accretion disk intersection
        if (crossesEquatorialPlane(prevPos, newPos)) { hitDisk = true; break; }

        // Check for celestial object (star) intersection
        if (interceptObject(ray)) { hitObject = true; break; }

        prevPos = newPos;

        // Stop if ray escaped far into deep space
        if (ray.r > ESCAPE_R) break;
    }

    // 3) Determine final pixel color based on what the ray encountered
    if (hitDisk) {
        // Accretion disk: compute radial color gradient from glowing gas/matter
        double r = length(vec3(ray.x, ray.y, ray.z)) / disk_r2;
        vec3 diskColor = vec3(1.0, r, 0.2);
        //r = 1.0 - abs(r - 0.5) * 2.0;
        color = vec4(diskColor, r);

    } else if (hitBlackHole) {
        // Event horizon: light cannot escape, renders completely black (shadow of black hole)
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (hitObject) {
        // Celestial object (star): diffuse lighting and surface color
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(cam.camPos - P);
        float ambient = 0.1;
        float diff = max(dot(N, V), 0.0);
        float intensity = ambient + (1.0 - ambient) * diff;
        vec3 shaded = objectColor.rgb * intensity;
        color = vec4(shaded, objectColor.a);

    } else {
        // Deep space background (empty space)
        color = vec4(0.0);
    }

    // 4) Write final color to the output texture image at this pixel coordinate
    imageStore(outImage, pix, color);
}